{
  "name": "@po-ignas/universal-liquid-glass",
  "version": "0.1.0",
  "description": "Cross-browser WebGL2 liquid glass for high-value navigation surfaces, with shared DOM capture and adaptive performance.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "vite --host 127.0.0.1",
    "demo:build": "vite build",
    "prepare": "npm run build",
    "clean": "rm -rf dist demo-dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "html2canvas-pro": "^1.5.11"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.4"
  },
  "keywords": [
    "liquid-glass",
    "webgl2",
    "react",
    "refraction",
    "glass",
    "ios",
    "shader"
  ],
  "license": "MIT",
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/po-ignas/universal-liquid-glass.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/po-ignas/universal-liquid-glass/issues"
  },
  "homepage": "https://github.com/po-ignas/universal-liquid-glass#readme"
}
